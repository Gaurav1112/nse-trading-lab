# Streamlit Cloud secrets template.
#
# On share.streamlit.io, after deploying, go to:
#   App -> Settings -> Secrets -> paste the contents below (with real values).
#
# DO NOT commit a real secrets.toml — it is gitignored and should stay so.
# Keep this file (.example) committed so future-you knows what to paste.

# --- Engine configuration (optional; v2 is the default if unset) ---
# NSE_SCORER_ENGINE = "v2"   # "v1" / "v2" / "v3" — v2 is default and proven.

# --- Risk envelope overrides (optional; defaults to capital ₹100k, 2% risk) ---
# NSE_LAB_CAPITAL_INR = "100000"
# NSE_LAB_RISK_PCT    = "2.0"

# --- Data directory (optional; ephemeral on Cloud — see DEPLOY.md) ---
# NSE_LAB_DATA_DIR = "/tmp/nse-trading-lab"

# --- Kite Connect (Phase 4 — not wired yet, scaffold only) ---
# KITE_API_KEY    = "..."
# KITE_API_SECRET = "..."
