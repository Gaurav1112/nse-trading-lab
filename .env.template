# NSE Trading Lab — copy to .env and fill in
# .env is gitignored. NEVER commit credentials.

# Kite Connect (Zerodha API) — optional, used when ChartInk/Kite features land
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# Override data directory (default ~/.nse-trading-lab)
# NSE_LAB_DATA_DIR=/your/custom/path

# Logging level for nse_backtest (DEBUG / INFO / WARNING / ERROR)
NSE_LOG_LEVEL=INFO

# Scorer engine (v1 = pre-Phase-2B, v2 = current default with tape-regime gate)
NSE_SCORER_ENGINE=v2
